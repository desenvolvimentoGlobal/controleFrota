# =============================================================================
# Controle de Frota — .env da RAIZ (dev direto no WAMP ou host do Docker).
#
# Em DOCKER existem DOIS arquivos: este (.env, lido pelo Compose no HOST para
# resolver ${...}: senha do MySQL e APP_URL) e o .env.docker (entra no
# container: APP_KEY, locale, VAPID). Ver .env.docker.example e o README do
# template em gestaoEmpresarial/docs/template-projeto.
# =============================================================================

APP_NAME="Controle de Frota"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# WAMP local: DB_HOST=127.0.0.1 · Docker: derivado de DOCKER_DB_* (não defina DB_* lá)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=controle_frota
DB_USERNAME=root
DB_PASSWORD=

# [Docker — host] credenciais do MySQL do container. Nunca commite valores reais.
DOCKER_DB_DATABASE=frota_db
DOCKER_DB_USERNAME=frota
DOCKER_DB_PASSWORD=
DOCKER_DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SÓ true com HTTPS (Traefik). Com true em HTTP o login falha em silêncio.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="frota@globalsuper.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# Web Push (notificações do navegador) — gere com: php artisan webpush:vapid
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
