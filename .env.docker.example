# =============================================================================
# TEMPLATE do  .env.docker  — variáveis injetadas DENTRO do container.
#
#     cp .env.docker.example .env.docker      (na RAIZ; NÃO versionado)
#
# É o `env_file:` dos serviços `app` e `worker` no compose.yaml.
#
# =============================================================================
#  NÃO CONFUNDA OS DOIS ARQUIVOS — É A ARMADILHA Nº 1 DO DEPLOY
# =============================================================================
#
#   .env.docker  (ESTE)  → entra no CONTAINER. Segredos e config do Laravel.
#   .env         (raiz)  → fica no HOST, lido pelo COMPOSE para resolver ${...}.
#                          É ele que decide a SENHA DO MYSQL e a APP_URL.
#
#   ⚠️ NÃO coloque DOCKER_DB_* aqui. O Compose NÃO lê este arquivo para
#      interpolação: o banco subiria com a senha de DEV do template, em silêncio.
#      Elas vão no .env.
#   ⚠️ NÃO coloque APP_URL aqui. É interpolada pela âncora x-app-env a partir do
#      .env do host — e `environment:` vence `env_file:`.
#   ⚠️ NUNCA suba com `--env-file .env.docker`: substitui o .env como fonte de
#      interpolação → DOCKER_DB_*/APP_URL somem → senha de dev, em silêncio.
#
# -----------------------------------------------------------------------------
# O QUE NÃO ADIANTA PÔR AQUI (a âncora x-app-env CRAVA e vence este arquivo):
#   APP_ENV · APP_DEBUG · APP_URL · LOG_CHANNEL · DB_CONNECTION · DB_HOST
#   DB_PORT · DB_DATABASE · DB_USERNAME · DB_PASSWORD · QUEUE_CONNECTION
#   CACHE_STORE · SESSION_DRIVER · FILESYSTEM_DISK
# Para mudar qualquer uma, edite o compose.yaml — não este arquivo.
# =============================================================================


# -----------------------------------------------------------------------------
# OBRIGATÓRIO em produção
# -----------------------------------------------------------------------------
APP_NAME="frota"

# Gere:  php artisan key:generate --show
# ⚠️ Deploy NOVO: gere. Migrando base EXISTENTE: reutilize a atual.
APP_KEY=

# Produção: warning. Esta chave NÃO está na âncora, então funciona de verdade.
LOG_LEVEL=warning


# -----------------------------------------------------------------------------
# Localização (pt-BR)
# -----------------------------------------------------------------------------
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR


# -----------------------------------------------------------------------------
# Sessão
# -----------------------------------------------------------------------------
# (SESSION_DRIVER é cravado como `database` pela âncora — não repita.)
SESSION_LIFETIME=120

# ⚠️ SÓ true COM HTTPS. Com true em HTTP o login falha em silêncio (o cookie
#    nem é enviado). Depende do trustProxies (bootstrap/app.php).
SESSION_SECURE_COOKIE=false


# -----------------------------------------------------------------------------
# Web Push (VAPID) — SEGREDOS (remova esta seção se o projeto não usa push)
# -----------------------------------------------------------------------------
# Gere:  php artisan webpush:vapid
# ⚠️ Se o projeto JÁ tem chaves, reutilize: gerar novas invalida as inscrições.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=


# -----------------------------------------------------------------------------
# Integração com o gestaoPessoas (RH) — token emitido LÁ:
#   php artisan integracao:token criar controle-frota
# Vazias = integração desligada.
# -----------------------------------------------------------------------------
GESTAO_PESSOAS_URL=
GESTAO_PESSOAS_TOKEN=
