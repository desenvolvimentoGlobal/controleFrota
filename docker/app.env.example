# =============================================================================
# TEMPLATE do  .env.docker  — variáveis injetadas DENTRO do container.
#
#     cp docker/app.env.example .env.docker      (na RAIZ; NÃO versionado)
#
# É o `env_file:` dos serviços `app` e `scheduler` no compose.yaml.
#
# =============================================================================
#  NÃO CONFUNDA OS DOIS ARQUIVOS — É A ARMADILHA Nº 1 DO DEPLOY
# =============================================================================
#
#   .env.docker  (ESTE)  → entra no CONTAINER. Segredos e config do Laravel.
#   .env         (raiz)  → fica no HOST, lido pelo COMPOSE para resolver ${...}.
#                          É ele que decide a SENHA DO MYSQL e a APP_URL.
#
#   ⚠️ NÃO coloque DOCKER_DB_* aqui. O Compose NÃO lê este arquivo para
#      interpolação: o banco subiria com a senha de DEV versionada no
#      repositório (gestao_dev_password), em silêncio. Elas vão no .env.
#
#   ⚠️ NÃO coloque APP_URL aqui. Ela é interpolada pela âncora x-app-env a
#      partir do .env do host — e `environment:` vence `env_file:`.
#
# -----------------------------------------------------------------------------
# O QUE NÃO ADIANTA PÔR AQUI (a âncora x-app-env CRAVA e vence este arquivo):
#   APP_ENV · APP_DEBUG · APP_URL · APP_LOCALE · LOG_CHANNEL · DB_CONNECTION
#   DB_HOST · DB_PORT · DB_DATABASE · DB_USERNAME · DB_PASSWORD
#   QUEUE_CONNECTION · CACHE_STORE · SESSION_DRIVER · FILESYSTEM_DISK
# Para mudar qualquer uma delas, edite o compose.yaml — não este arquivo.
# =============================================================================


# -----------------------------------------------------------------------------
# OBRIGATÓRIO em produção
# -----------------------------------------------------------------------------
APP_NAME="Gestao de Pessoas"

# Gere com:  php artisan key:generate --show
# ⚠️ Deploy NOVO: gere uma chave. Migrando base EXISTENTE: reutilize a atual —
#    trocá-la invalida sessões e qualquer dado cifrado (senhas não; são hash).
APP_KEY=

# Produção: warning (debug polui e pode vazar dado em log).
LOG_LEVEL=warning


# -----------------------------------------------------------------------------
# Localização (pt-BR)
# -----------------------------------------------------------------------------
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR


# -----------------------------------------------------------------------------
# Sessão
# -----------------------------------------------------------------------------
SESSION_LIFETIME=120

# ⚠️ Com HTTPS (Traefik + Let's Encrypt): true — só envia o cookie de sessão
# por conexão segura.
SESSION_SECURE_COOKIE=true


# -----------------------------------------------------------------------------
# Ponto eletrônico — portal do Flit
# -----------------------------------------------------------------------------
# Usadas pelo comando `ponto:baixar-afd`, que o scheduler roda 08:30 e 18:30.
# SEM ELAS o comando falha dizendo qual chave falta — o resto do sistema segue
# funcionando (o DP continua podendo subir o AFD à mão pela tela).
#
# FLIT_CONTA_ID e FLIT_EMPRESA_ID são SEGREDO: a função de exportação do Flit
# responde sem exigir login, então quem tem os dois baixa o AFD da empresa
# inteira — que é uma lista de CPFs.
#
# Os valores são os mesmos do .env de desenvolvimento. Se não souber, veja em
# manager.flitapp.com.br com o DevTools na chamada oncall_exportar_arquivo_afd.
FLIT_URL=https://manager.flitapp.com.br
FLIT_USUARIO=
FLIT_SENHA=
FLIT_API_KEY=
FLIT_CONTA_ID=
FLIT_EMPRESA_ID=

# Tolerância de atraso em minutos (limite da CLT). Cada jornada pode
# sobrescrever pela tela; deixe em branco para usar o padrão do config (10).
PONTO_TOLERANCIA_MINUTOS=10

# Preenchido, recusa AFD de outro CNPJ na importação. Só números.
PONTO_CNPJ_EMPREGADOR=

# Até quantos meses para trás o DP/RH pode corrigir, anular ou incluir batida.
# Dia futuro é sempre barrado. O horário do relógio nunca é apagado — a
# correção é uma camada por cima, sempre reversível.
PONTO_JANELA_CORRECAO_MESES=6


# -----------------------------------------------------------------------------
# Integração com o gestaoEmpresarial — webhook de colaboradores (2026-09-17)
# -----------------------------------------------------------------------------
# Este sistema AVISA o gestaoEmpresarial quando um colaborador muda (e, em
# especial, quando é desligado — lá isso dispara a cobrança do patrimônio em
# tutela). O token é emitido LÁ, no container do gestaoEmpresarial:
#   docker compose exec -T app php artisan integracao:token criar gestao-pessoas --escopos=colaboradores
# A URL é a pública dele (passa pelo Traefik). Vazias = integração desligada:
# o resto do sistema segue normal. Pendências: `integracao:enviar-webhooks --listar`.
GESTAO_EMPRESARIAL_URL=
GESTAO_EMPRESARIAL_TOKEN=


# -----------------------------------------------------------------------------
# Web Push (notificações do navegador)
# -----------------------------------------------------------------------------
# Gere o par com:  docker compose exec -T app php artisan webpush:vapid
# Sem as chaves o sistema funciona normalmente, só sem push (o botão
# "Ativar notificações" não aparece). Push exige HTTPS — ok com o Traefik.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
